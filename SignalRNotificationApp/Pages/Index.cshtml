@page
@model SignalRNotificationApp.Pages.IndexModel
@{
    ViewData["Title"] = "Real-Time Notifications";
}

<h2>@ViewData["Title"]</h2>

<!-- Form nhập thông báo -->
<input id="notificationTitle" type="text" placeholder="Nhập tiêu đề thông báo" />
<input id="notificationDescription" type="text" placeholder="Nhập nội dung thông báo" />
<input id="notificationTypes" type="number" placeholder="Loại thông báo (e.g., 1)" />
<input id="accountID" type="text" placeholder="ID Tài khoản (e.g., 3fa85f64-5717-4562-b3fc-2c963f66afa6)" />
<input id="referenceId" type="text" placeholder="ID Tham chiếu (e.g., 3fa85f64-5717-4562-b3fc-2c963f66afa6)" />
<button id="sendNotificationButton">Gửi Thông Báo</button>

<hr />
<!-- Danh sách thông báo -->
<h3>Thông báo nhận được:</h3>
<ul id="notificationsList"></ul>

<!-- Thêm thư viện SignalR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/3.1.0/signalr.min.js"></script>
<script type="text/javascript">
    // Khởi tạo kết nối SignalR
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7151/notificationHub")
        .build();

    connection.serverTimeoutInMilliseconds = 30000;

    // Xử lý sự kiện khi nhận thông báo từ SignalR
    connection.on("ReceiveNotification", function (title, description) {
        console.log("Received notification from SignalR:", title, description); // Log kiểm tra

        // Thêm thông báo vào danh sách
        const li = document.createElement("li");
        li.textContent = `Tiêu đề: ${title} - Nội dung: ${description}`;
        document.getElementById("notificationsList").appendChild(li);
    });

    // Bắt đầu kết nối và xử lý sự kiện ngắt kết nối
    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR Connected");
        } catch (err) {
            console.error("SignalR Connection Error:", err);
            setTimeout(startConnection, 5000); // Tự động kết nối lại sau 5 giây
        }
    }

    // Xử lý sự kiện ngắt kết nối và thử kết nối lại
    connection.onclose(async (error) => {
        console.error("Connection closed due to error. Trying to reconnect...", error);
        await startConnection();
    });

    startConnection();

    // Gửi thông báo khi nhấn nút "Gửi Thông Báo"
    document.getElementById("sendNotificationButton").addEventListener("click", async function () {
        const title = document.getElementById("notificationTitle").value;
        const description = document.getElementById("notificationDescription").value;
        const notificationTypes = parseInt(document.getElementById("notificationTypes").value);
        const accountID = document.getElementById("accountID").value;
        const referenceId = document.getElementById("referenceId").value;

        // Gọi API để tạo thông báo mới
        const response = await fetch('https://localhost:7151/api/v1/notifications/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                title: title,
                description: description,
                notificationTypes: notificationTypes,
                accountID: accountID,
                referenceId: referenceId
            })
        });

        if (response.ok) {
            alert("Thông báo đã được tạo và gửi thành công.");
        } else {
            alert("Lỗi khi tạo thông báo.");
        }
    });
</script>
